DATABASE_URL=postgresql://financed:financed@localhost:5432/financed

# Auth.js. Generate AUTH_SECRET with `npx auth secret` and set it only in the environment.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Set true on Render so Auth.js accepts the platform's forwarded host headers.
AUTH_TRUST_HOST=false

# A provider is enabled only when all of its variables below are present.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

DOCUMENT_STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# Required when DOCUMENT_STORAGE_BACKEND=s3 (for example, Cloudflare R2)
DOCUMENT_STORAGE_S3_ENDPOINT=
DOCUMENT_STORAGE_S3_REGION=auto
DOCUMENT_STORAGE_S3_BUCKET=
DOCUMENT_STORAGE_S3_ACCESS_KEY_ID=
DOCUMENT_STORAGE_S3_SECRET_ACCESS_KEY=

# Required before saving company provider keys through /settings/ai.
# Base64-encoded 32-byte deployment master key; set the value in Render only.
AI_SETTINGS_ENCRYPTION_KEY=

# Explicit non-production-only legacy fallback. Never enable this in production.
AI_LEGACY_LOCAL_DEVELOPMENT=false
AI_API_KEY=
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_MODEL=mimo-v2.5
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
