{
  "name": "financed-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "auth:provision": "tsx scripts/company-access.ts provision",
    "auth:grant": "tsx scripts/company-access.ts grant",
    "auth:revoke": "tsx scripts/auth-membership.ts revoke",
    "db:push": "drizzle-kit push",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "probe:layout": "tsx scripts/probe-layout-extraction.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@aws-sdk/client-s3": "^3.1114.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.42.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
